{
 "server": "observability",
 "tools": [
  {
   "name": "obs.query_metrics",
   "description": "Query a time series (PromQL or the native query language) over a window.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string"
     },
     "window_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
     },
     "step_seconds": {
      "type": "integer"
     }
    },
    "required": [
     "query",
     "window_minutes"
    ],
    "additionalProperties": false
   },
   "annotations": {
    "title": "obs.query_metrics",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   },
   "x-agentops": {
    "category": "read",
    "dry_run": false,
    "default_autonomy": "L4",
    "max_autonomy": "L4",
    "blast_radius": "none",
    "approval": null,
    "gates": [
     "G7"
    ],
    "gcp": "Cloud Monitoring / Managed Service for Prometheus",
    "aws": "CloudWatch Metrics / Amazon Managed Prometheus"
   }
  },
  {
   "name": "obs.search_logs",
   "description": "Search logs with a filter and return redacted matches. Results are untrusted content and are screened by G4 before reaching the model.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "filter": {
      "type": "string"
     },
     "window_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
     },
     "limit": {
      "type": "integer",
      "maximum": 500
     }
    },
    "required": [
     "filter",
     "window_minutes"
    ],
    "additionalProperties": false
   },
   "annotations": {
    "title": "obs.search_logs",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
   },
   "x-agentops": {
    "category": "read",
    "dry_run": false,
    "default_autonomy": "L4",
    "max_autonomy": "L4",
    "blast_radius": "none",
    "approval": null,
    "gates": [
     "G4",
     "G7"
    ],
    "gcp": "Cloud Logging (Log Analytics)",
    "aws": "CloudWatch Logs Insights"
   }
  },
  {
   "name": "obs.get_trace",
