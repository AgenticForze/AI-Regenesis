    "default_autonomy": "L4",
    "max_autonomy": "L4",
    "blast_radius": "none",
    "approval": null,
    "gates": [
     "G7"
    ],
    "gcp": "Cloud Trace",
    "aws": "AWS X-Ray"
   }
  },
  {
