   "inputSchema": {
    "type": "object",
    "properties": {
     "scope": {
      "type": "string"
     },
     "days": {
      "type": "integer",
      "maximum": 400
     }
    },
    "required": [
     "scope",
     "days"
    ],
    "additionalProperties": false
   },
   "annotations": {
