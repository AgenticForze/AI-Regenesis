flowchart TB
  subgraph L1["🔗 Data &amp; Integration Layer"]
    D0["Government ID/Document Upload"]
    D1["Sanctions/PEP Databases"]
    D2["Business Registry Data"]
    D3["Application Form Data"]
  end
  subgraph L2["🧭 Orchestration Layer"]
    ORCH{"KYC Onboarding Orchestrator Agent"}
  end
  subgraph L3["🤖 Agent Layer (parallel specialists)"]
    W0["Identity Document Verification Agent"]
    W1["Sanctions/PEP Screening Agent"]
    W2["Beneficial Ownership Agent (for business accounts)"]
    W3["Customer Risk Rating Agent"]
    W4["Source of Funds Agent"]
    AGG["Aggregator / Synthesis Agent"]
    W0 --> AGG
    W1 --> AGG
    W2 --> AGG
    W3 --> AGG
    W4 --> AGG
  end
  subgraph L4["⚙️ Action &amp; Execution Layer"]
    ACT[/Action Agent/]
    SYS0[("Account Opening System Approval")]
    ACT --> SYS0
    SYS1[("Enhanced Due Diligence (EDD) Queue")]
    ACT --> SYS1
    SYS2[("Welcome Kit / Rejection Notice")]
    ACT --> SYS2
  end
  L1 --> L2
  ORCH --> W0
  ORCH --> W1
  ORCH --> W2
  ORCH --> W3
  ORCH --> W4
  AGG --> HUMAN
  HUMAN --> ACT
  subgraph OBS["📊 Observability &amp; Governance Layer (cross-cutting)"]
    TRACE["Tracing &amp; Telemetry<br/>(OpenTelemetry)"]:::obsNode
    AUDIT["Immutable Audit Log"]:::obsNode
    GUARD["Guardrails / Policy Engine"]:::obsNode
    HUMAN{"EDD Analyst Review for High-Risk Customers"}:::obsNode
  end
  L2 -.telemetry.-> OBS
  L3 -.telemetry.-> OBS
  L4 -.audit.-> OBS
  classDef dataLayer fill:#0F2A28,stroke:#2FD3C7,stroke-width:1px,color:#E7ECF3;
