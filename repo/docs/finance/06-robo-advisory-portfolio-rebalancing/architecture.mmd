flowchart TB
  subgraph L1["🔗 Input Layer"]
    IN(["Trigger / Incoming Record"])
  end
  subgraph L3["🤖 Agent Pipeline Layer (sequential)"]
    S0["Drift Detection Agent"]
    S1["Tax-Impact Analysis Agent"]
    S2["Suitability/Risk-Profile Check Agent"]
    S3["Trade List Generation Agent"]
    S4["Client Communication Agent"]
    S0 --> S1
    S1 --> S2
    S2 --> S3
    S3 --> S4
  end
  subgraph L4["⚙️ Action &amp; Execution Layer"]
    SYS0[("Trade Execution via OMS")]
    SYS1[("Client Notification of Rebalancing")]
    SYS2[("Compliance Record Filing")]
  end
  IN --> L3
  S4 --> SYS0
  S4 --> SYS1
  S4 --> SYS2
  subgraph OBS["📊 Observability &amp; Governance Layer (cross-cutting)"]
    TRACE["Tracing &amp; Telemetry<br/>(OpenTelemetry)"]:::obsNode
    AUDIT["Immutable Audit Log"]:::obsNode
    GUARD["Guardrails / Policy Engine"]:::obsNode
  end
  L3 -.telemetry (per-stage span).-> OBS
  L4 -.audit.-> OBS
