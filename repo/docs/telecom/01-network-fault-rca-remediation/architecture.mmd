flowchart TB
  subgraph L1["🔗 Data &amp; Integration Layer"]
    D0["FM/PM Alarms (Ceragon/Ericsson/Nokia EMS)"]
    D1["Network Topology (Netbox/inventory DB)"]
    D2["Streaming Telemetry (gNMI/Kafka)"]
    D3["Past Incident Tickets (ServiceNow)"]
  end
  subgraph L2["🧭 Orchestration Layer"]
    ORCH{"NOC Incident Orchestrator Agent"}
  end
  subgraph L3["🤖 Agent Layer (parallel specialists)"]
    W0["RAN Alarm Correlation Agent"]
    W1["Transport/IP Topology Agent"]
    W2["Core Network (5GC/EPC) Agent"]
    W3["Performance-KPI Deviation Agent"]
    W4["Historical Ticket Similarity Agent"]
    AGG["Aggregator / Synthesis Agent"]
    W0 --> AGG
    W1 --> AGG
    W2 --> AGG
    W3 --> AGG
    W4 --> AGG
  end
  subgraph L4["⚙️ Action &amp; Execution Layer"]
    ACT[/Action Agent/]
    SYS0[("Auto-remediation via Ansible/NETCONF")]
    ACT --> SYS0
    SYS1[("ServiceNow Incident Update")]
    ACT --> SYS1
    SYS2[("NOC Dashboard/Slack Alert")]
    ACT --> SYS2
  end
  L1 --> L2
  ORCH --> W0
  ORCH --> W1
  ORCH --> W2
  ORCH --> W3
  ORCH --> W4
  AGG --> HUMAN
  HUMAN --> ACT
  subgraph OBS["📊 Observability &amp; Governance Layer (cross-cutting)"]
    TRACE["Tracing &amp; Telemetry<br/>(OpenTelemetry)"]:::obsNode
    AUDIT["Immutable Audit Log"]:::obsNode
    GUARD["Guardrails / Policy Engine"]:::obsNode
    HUMAN{"SRE Approval for High-Blast-Radius Actions"}:::obsNode
  end
  L2 -.telemetry.-> OBS
  L3 -.telemetry.-> OBS
  L4 -.audit.-> OBS
  classDef dataLayer fill:#0F2A28,stroke:#2FD3C7,stroke-width:1px,color:#E7ECF3;
  classDef orchLayer fill:#241B3D,stroke:#8C7CFF,stroke-width:1.5px,color:#E7ECF3;
  classDef agentLayer fill:#141A28,stroke:#4C8DFF,stroke-width:1px,color:#E7ECF3;
  classDef actionLayer fill:#3D2A1B,stroke:#E8B23C,stroke-width:1px,color:#E7ECF3;
  classDef obsLayer fill:#3D1B24,stroke:#FF7A66,stroke-width:1px,color:#E7ECF3;
  classDef obsNode fill:#2A1319,stroke:#FF7A66,stroke-width:1px,color:#E7ECF3,stroke-dasharray: 2 2;
  class L1 dataLayer;
  class L2 orchLayer;
  class L3 agentLayer;
  class L4 actionLayer;
  class OBS obsLayer;