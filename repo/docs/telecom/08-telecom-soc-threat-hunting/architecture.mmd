flowchart TB
  subgraph L1["🔗 Data &amp; Integration Layer"]
    D0["SIEM (Splunk/Sentinel)"]
    D1["Signaling Firewall Logs"]
    D2["NetFlow/sFlow Data"]
    D3["Threat Intel Feeds (STIX/TAXII)"]
  end
  subgraph L2["🧭 Orchestration Layer"]
    ORCH{"SOC Incident Response Orchestrator"}
  end
  subgraph L3["🤖 Agent Layer (parallel specialists)"]
    W0["Signaling Abuse Detection Agent (SS7/Diameter/GTP)"]
    W1["DDoS Detection Agent"]
    W2["SIEM Correlation Agent"]
    W3["Threat Intelligence Enrichment Agent"]
    W4["Insider-Threat Behavioral Agent"]
    AGG["Aggregator / Synthesis Agent"]
    W0 --> AGG
    W1 --> AGG
    W2 --> AGG
    W3 --> AGG
    W4 --> AGG
  end
  subgraph L4["⚙️ Action &amp; Execution Layer"]
    ACT[/Action Agent/]
    SYS0[("Auto-block via Signaling Firewall")]
    ACT --> SYS0
    SYS1[("SOAR Playbook Execution")]
    ACT --> SYS1
    SYS2[("Analyst Case in SOAR Platform")]
    ACT --> SYS2
  end
  L1 --> L2
  ORCH --> W0
  ORCH --> W1
  ORCH --> W2
  ORCH --> W3
  ORCH --> W4
  AGG --> HUMAN
  HUMAN --> ACT
  subgraph OBS["📊 Observability &amp; Governance Layer (cross-cutting)"]
    TRACE["Tracing &amp; Telemetry<br/>(OpenTelemetry)"]:::obsNode
    AUDIT["Immutable Audit Log"]:::obsNode
    GUARD["Guardrails / Policy Engine"]:::obsNode
    HUMAN{"SOC Tier-2 Analyst Approval for Containment Actions"}:::obsNode
  end
  L2 -.telemetry.-> OBS
  L3 -.telemetry.-> OBS
  L4 -.audit.-> OBS
  classDef dataLayer fill:#0F2A28,stroke:#2FD3C7,stroke-width:1px,color:#E7ECF3;
