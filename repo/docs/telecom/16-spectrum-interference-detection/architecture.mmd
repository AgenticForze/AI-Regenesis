flowchart TB
  subgraph L1["🔗 Data &amp; Integration Layer"]
    D0["Distributed Spectrum Sensors"]
    D1["PM/KPI Data"]
    D2["Site Equipment Inventory"]
    D3["Regulatory Spectrum Database"]
  end
  subgraph L2["🧭 Orchestration Layer"]
    ORCH{"Interference Investigation Orchestrator"}
  end
  subgraph L3["🤖 Agent Layer (parallel specialists)"]
    W0["Spectrum Sensor Data Agent"]
    W1["Interference Source Triangulation Agent"]
    W2["PM/KPI Impact Correlation Agent"]
    W3["Regulatory Filing Agent"]
    AGG["Aggregator / Synthesis Agent"]
    W0 --> AGG
    W1 --> AGG
    W2 --> AGG
    W3 --> AGG
  end
  subgraph L4["⚙️ Action &amp; Execution Layer"]
    ACT[/Action Agent/]
    SYS0[("Frequency Reassignment Request")]
    ACT --> SYS0
    SYS1[("Field Investigation Work Order")]
    ACT --> SYS1
    SYS2[("Regulatory Complaint Filing")]
    ACT --> SYS2
  end
  L1 --> L2
  ORCH --> W0
  ORCH --> W1
  ORCH --> W2
  ORCH --> W3
  AGG --> ACT
  subgraph OBS["📊 Observability &amp; Governance Layer (cross-cutting)"]
    TRACE["Tracing &amp; Telemetry<br/>(OpenTelemetry)"]:::obsNode
    AUDIT["Immutable Audit Log"]:::obsNode
    GUARD["Guardrails / Policy Engine"]:::obsNode
  end
  L2 -.telemetry.-> OBS
  L3 -.telemetry.-> OBS
  L4 -.audit.-> OBS
