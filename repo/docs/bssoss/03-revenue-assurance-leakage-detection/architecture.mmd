flowchart TB
  subgraph L1["🔗 Data Layer"]
    BB[("Revenue Assurance Blackboard (usage, rating, billing, provisioning cross-references)")]
  end
  subgraph L2["🧭 Orchestration Layer"]
    CTRL{"Revenue Assurance Controller Agent"}
  end
  subgraph L3["🤖 Agent Layer (read/write blackboard)"]
    A0["Usage-to-Billing Reconciliation Agent"]
    A1["Discount Misapplication Agent"]
    A2["Un-activated Service Agent"]
    A3["Rating Configuration Drift Agent"]
    A4["Zero-Usage/Zero-Billing Anomaly Agent"]
  end
  subgraph L4["⚙️ Action &amp; Execution Layer"]
    SYS0[("Leakage Case for Finance Review")]
    SYS1[("Automated Re-billing/Correction")]
    SYS2[("Systemic Root-Cause Ticket to Engineering")]
  end
  L1 <--> L2
  A0 <--> BB
  CTRL -.trigger.-> A0
  A1 <--> BB
  CTRL -.trigger.-> A1
  A2 <--> BB
  CTRL -.trigger.-> A2
  A3 <--> BB
  CTRL -.trigger.-> A3
  A4 <--> BB
  CTRL -.trigger.-> A4
  CTRL --> SYS0
  CTRL --> SYS1
  CTRL --> SYS2
  subgraph OBS["📊 Observability &amp; Governance Layer (cross-cutting)"]
    TRACE["Tracing &amp; Telemetry<br/>(OpenTelemetry)"]:::obsNode
    AUDIT["Immutable Audit Log"]:::obsNode
    GUARD["Guardrails / Policy Engine"]:::obsNode
  end
  L2 -.telemetry.-> OBS
  L3 -.telemetry.-> OBS
  L4 -.audit.-> OBS
