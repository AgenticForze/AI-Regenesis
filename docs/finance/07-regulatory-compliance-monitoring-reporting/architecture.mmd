flowchart TB
  subgraph L1["🔗 Intent / Request Layer"]
    REQ(["Incoming Request / Intent"])
  end
  subgraph L2["🧭 Orchestration Layer"]
    TOP{"Regulatory Compliance Orchestrator"}
  end
  subgraph L3["🤖 Agent Layer (manager-of-managers)"]
    subgraph L3_0["Capital/Liquidity Reporting Manager Agent"]
      M0(("Capital/Liquidity Reporting Manager Agent<br/>Domain Manager"))
      L0_0["Basel Capital Ratio Calculation Agent"]
      M0 --> L0_0
      L0_1["LCR/NSFR Liquidity Agent"]
      M0 --> L0_1
      L0_2["Data Reconciliation Agent"]
      M0 --> L0_2
    end
    subgraph L3_1["Trade/Transaction Reporting Manager Agent"]
      M1(("Trade/Transaction Reporting Manager Agent<br/>Domain Manager"))
      L1_0["MiFID II Transaction Reporting Agent"]
      M1 --> L1_0
      L1_1["Trade Reporting Exception Agent"]
      M1 --> L1_1
    end
  end
  subgraph L4["⚙️ Action &amp; Execution Layer"]
    RES["Resolution / Reporting Agent"]
    SYS0[("Regulatory Report Submission")]
    RES --> SYS0
    SYS1[("Internal Compliance Dashboard")]
    RES --> SYS1
    SYS2[("Breach/Exception Escalation")]
    RES --> SYS2
  end
  L1 --> L2
  REQ --> TOP
  TOP --> M0
  TOP --> M1
  L3 --> L4
  TOP --> RES
  subgraph OBS["📊 Observability &amp; Governance Layer (cross-cutting)"]
    TRACE["Tracing &amp; Telemetry<br/>(OpenTelemetry)"]:::obsNode
    AUDIT["Immutable Audit Log"]:::obsNode
    GUARD["Guardrails / Policy Engine"]:::obsNode
  end
  L2 -.telemetry.-> OBS
  L3 -.telemetry.-> OBS
  L4 -.audit.-> OBS
