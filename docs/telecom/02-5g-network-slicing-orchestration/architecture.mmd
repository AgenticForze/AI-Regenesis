flowchart TB
  subgraph L1["🔗 Intent / Request Layer"]
    REQ(["Incoming Request / Intent"])
  end
  subgraph L2["🧭 Orchestration Layer"]
    TOP{"Slice Lifecycle Orchestrator (E2E)"}
  end
  subgraph L3["🤖 Agent Layer (manager-of-managers)"]
    subgraph L3_0["RAN Domain Manager Agent"]
      M0(("RAN Domain Manager Agent<br/>Domain Manager"))
      L0_0["RAN Resource Partitioning Agent"]
      M0 --> L0_0
      L0_1["gNB Config Agent"]
      M0 --> L0_1
      L0_2["RAN SLA Assurance Agent"]
      M0 --> L0_2
    end
    subgraph L3_1["Transport Domain Manager Agent"]
      M1(("Transport Domain Manager Agent<br/>Domain Manager"))
      L1_0["Transport Slicing (VPN/Segment Routing) Agent"]
      M1 --> L1_0
      L1_1["Bandwidth Reservation Agent"]
      M1 --> L1_1
    end
    subgraph L3_2["Core (5GC) Domain Manager Agent"]
      M2(("Core (5GC) Domain Manager Agent<br/>Domain Manager"))
      L2_0["Network Slice Subnet (NSSMF) Agent"]
      M2 --> L2_0
      L2_1["QoS/5QI Policy Agent"]
      M2 --> L2_1
      L2_2["Core Assurance Agent"]
      M2 --> L2_2
    end
  end
  subgraph L4["⚙️ Action &amp; Execution Layer"]
    RES["Resolution / Reporting Agent"]
    SYS0[("OSS/BSS Order Fulfillment")]
    RES --> SYS0
    SYS1[("SLA Dashboard for Enterprise Customer")]
    RES --> SYS1
    SYS2[("Auto-Scaling Trigger (K8s/CNF)")]
    RES --> SYS2
  end
  L1 --> L2
  REQ --> TOP
  TOP --> M0
  TOP --> M1
  TOP --> M2
  L3 --> L4
  TOP --> RES
  subgraph OBS["📊 Observability &amp; Governance Layer (cross-cutting)"]
    TRACE["Tracing &amp; Telemetry<br/>(OpenTelemetry)"]:::obsNode
    AUDIT["Immutable Audit Log"]:::obsNode
    GUARD["Guardrails / Policy Engine"]:::obsNode
  end
  L2 -.telemetry.-> OBS
  L3 -.telemetry.-> OBS
  L4 -.audit.-> OBS
